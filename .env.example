# DeepSeek 肥鱼娘桌宠 —— 配置模板
# 用法：把本文件复制为 .env（同目录），填入你自己的值。
# .env 已在 .gitignore 中，绝不会被提交；本模板只含变量名，不含任何真实密钥。

# DeepSeek 接口地址（一般不用改）
DEEPSEEK_API_BASE=https://api.deepseek.com

# 模型名
DEEPSEEK_MODEL=deepseek-chat

# 请求超时（秒）
DEEPSEEK_TIMEOUT=60

# ★ 你的 DeepSeek API Key（必填）。多个 Key 用英文逗号分隔，或按
#   DEEPSEEK_API_KEY_1 / DEEPSEEK_API_KEY_2 ... 逐个写。
#   在 https://platform.deepseek.com/api_keys 创建。
DEEPSEEK_API_KEYS=sk-你的密钥

# 本地数据库口令（加密对话内容用，自己随便设一个强口令并牢记；
# 改了之后旧对话会解不开）
DB_PASSWORD=请改成你自己的强口令
